      <rdf:Description rdf:about="#MACROINDICATOR"/>
      <rdf:Description rdf:about="#CONCEPT"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:ObjectProperty rdf:about="#has_sector">
    <rdfs:domain rdf:resource="#COMPANY"/>
