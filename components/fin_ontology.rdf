<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/finance#"
     xml:base="http://example.org/finance"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/finance"/>

  <owl:Class rdf:about="#FINANCIALENTITY"/>
  <owl:Class rdf:about="#COMPANY"/>
  <owl:Class rdf:about="#DERIVATIVE"/>
  <owl:Class rdf:about="#CURRENCY"/>
  <owl:Class rdf:about="#BOND"/>
